# Backend
PORT=3000
API_PREFIX=/api
NODE_ENV=development

# PostgreSQL (TypeORM)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vipasa
POSTGRES_PASSWORD=vipasa
POSTGRES_DB=vipasa

# MongoDB (Mongoose)
MONGO_URI=mongodb://localhost:27017/vipasa

# RabbitMQ
RABBITMQ_URI=amqp://vipasa:vipasa@localhost:5672
RABBITMQ_EXCHANGE=vipasa.events

# Chroma (Vector DB)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=user_memory

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
