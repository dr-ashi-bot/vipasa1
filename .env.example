# Backend
PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vipasa
POSTGRES_USER=vipasa
POSTGRES_PASSWORD=vipasa

# MongoDB
MONGO_URI=mongodb://localhost:27017/vipasa

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=gamification.progress

# Chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=ashi-memory

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o

# Session defaults
SESSION_DURATION_MINUTES=18
