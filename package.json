{
  "name": "vipasa1",
  "private": true,
  "version": "0.1.0",
  "description": "Adaptive learning platform for hyper-personalized student flow-state experiences.",
  "workspaces": [
    "apps/backend",
    "apps/mobile",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace @vipasa/backend && npm run build --workspace @vipasa/web",
    "test": "npm run test --workspace @vipasa/backend",
    "start:backend": "npm run start --workspace @vipasa/backend",
    "start:mobile": "npm run start --workspace @vipasa/mobile",
    "start:web": "npm run dev --workspace @vipasa/web",
    "build:web": "npm run build --workspace @vipasa/web",
    "deploy:web:vercel": "npx vercel --cwd apps/web --prod --yes"
  }
}
