# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=adaptive_user
POSTGRES_PASSWORD=adaptive_pass
POSTGRES_DB=adaptive_learning

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/adaptive_learning

# AI API Keys (at least one required for AI content generation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector Database (Pinecone) - optional for production
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=adaptive-learning-memory

# Application
NODE_ENV=development
PORT=3000
