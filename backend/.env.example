PORT=3000

# PostgreSQL (UserProfile + BKTMastery)
POSTGRES_ENABLED=true
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/adaptive_learning

# MongoDB (GamificationState + XP streams)
MONGO_ENABLED=true
MONGO_URI=mongodb://mongo:27017/adaptive_learning

# RabbitMQ (async progress events)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_PROGRESS_QUEUE=adaptive.progress.submitted

# Vector memory (Chroma)
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=adaptive-learning-memory

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
